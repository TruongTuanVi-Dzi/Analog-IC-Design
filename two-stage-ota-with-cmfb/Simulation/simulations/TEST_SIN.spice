** sch_path: /home/tundzi-lp1710/LAYOUT_ANALOG_FALL_DTVT/DO_AN_BAO_CAO/All_Block/TEST_SIN.sch
**.subckt TEST_SIN
VDD VDD VSS 1.2
VSS VSS 0 0.0
V_IN V_IN VSS DC 0.6 AC -1.0 SIN(0.6 0.25 1Meg 0 0 180)
V_IP V_IP VSS DC 0.6 AC 1.0 SIN(0.6 0.25 1Meg)
V_BIAS V_BIAS VSS DC 0.7
V_BIAS1 VCM VSS DC 0.4
CL1 VOP VSS 2p
x1 VSS V_BIAS4 V_BIAS2 V_BIAS3 VDD V_BIAS1 V_BIAS BIAS_Block
x2 VDD V_BIAS1 net1 net2 V_BIAS2 V_ON1 V_OP1 V_BIAS1 VON VOP VCMFBG V_BIAS4 VSS CASCODE_Block
x3 VDD V_BIAS1 VCM VOP VON VCMFBL VCMFBG VSS CMFB_Block
CL2 VON VSS 2p
R1 V_IN net1 1k
R2 net2 V_IP 1k
R3 net1 VOP 1k
R4 net2 VON 1k
**** begin user architecture code


.lib cornerMOSlv.lib mos_tt




* RUN SINE RESPONSE & THD
.control
set color0=white
set color1=black

tran 1n 6u

let v_out_sine = v(vop) - v(von)
let v_in_sine  = v(v_ip) - v(v_in)

* Do bien do dinh - dinh tren cac chu ky xac lap (tu 3us den 6us)
meas tran v_max_sine max v_out_sine from=3u to=6u
meas tran v_min_sine min v_out_sine from=3u to=6u
let v_swing_pp = v_max_sine - v_min_sine

* Phan tich pho Fourier va THD
fourier 1Meg v_out_sine

echo '=========================================================================='
echo 'KET QUA LARGE-SIGNAL SINE (1 MHz):'
echo '=========================================================================='
print v_swing_pp

* Ve do thi kiem tra
plot v_in_sine v_out_sine ylabel 'Differential Voltage (V)' xlabel 'Time (s)' title 'Large-Signal 1 MHz Sinusoidal Response'
.endc


**** end user architecture code
**.ends

